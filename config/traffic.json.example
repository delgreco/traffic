{
  "state_file": "state/traffic_state.json",
  "output_dir": "output",
  "raw_retention_days": 30,
  "max_recent_logs_per_vhost": 1000,
  "default_vhost_from_filename": true,
  "filename_vhost_regex": "^(.+?)(?:[-_.]ssl)?(?:[-_.]access)?\\.log",
  "log_sources": [
    {
      "path": "/var/log/apache2/other_vhosts_access.log*",
      "vhost": null
    },
    {
      "path": "/var/log/apache2/access.log*",
      "vhost": "example.com"
    },
    {
      "path": "/var/log/apache2/subdomain-example-access.log*",
      "vhost": "subdomain.example.com"
    },
    {
      "path": "/var/log/apache2/subdomain-example-ssl-access.log*",
      "vhost": "subdomain.example.com"
    }
  ]
}
